{
  "name": "rabbit-hole",
  "displayName": "Rabbit Hole",
  "description": "Dev time intelligence — automatic tracking, AI agent attribution, activity dashboard",
  "version": "0.5.0",
  "publisher": "rabbit-hole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/platinumfalcon98/rabbit-hole.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "time tracking",
    "productivity",
    "statistics",
    "dashboard",
    "streak"
  ],
  "bugs": {
    "url": "https://github.com/platinumfalcon98/rabbit-hole/issues"
  },
  "homepage": "https://github.com/platinumfalcon98/rabbit-hole#readme",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rabbithole",
          "title": "Rabbit Hole",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "rabbithole": [
        {
          "type": "webview",
          "id": "rabbithole.miniView",
          "name": "Today"
        }
      ]
    },
    "commands": [
      {
        "command": "rabbithole.openDashboard",
        "title": "Rabbit Hole: Open Dashboard",
        "icon": "$(clock)"
      }
    ],
    "configuration": {
      "title": "Rabbit Hole",
      "properties": {
        "rabbithole.dailyTargetMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 1440,
          "description": "Daily active-coding target in minutes. A day counts toward your streak once you reach it."
        },
        "rabbithole.idleThresholdMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "Pause the active timer after this many minutes with no activity."
        },
        "rabbithole.crt.mask": {
          "type": "string",
          "enum": [
            "slot",
            "grille",
            "shadow",
            "off"
          ],
          "enumDescriptions": [
            "Staggered RGB slots, as on most consumer TVs and terminals.",
            "Unbroken vertical stripes (Trinitron).",
            "Round dot triads.",
            "No CRT effect."
          ],
          "default": "slot",
          "description": "Phosphor mask drawn over the dashboard and sidebar."
        },
        "rabbithole.crt.pitch": {
          "type": "string",
          "enum": [
            "fine",
            "medium",
            "coarse"
          ],
          "default": "fine",
          "description": "Size of the mask's phosphor cells."
        },
        "rabbithole.crt.strength": {
          "type": "number",
          "default": 23,
          "minimum": 0,
          "maximum": 100,
          "description": "How strongly the mask darkens the screen, from 0 to 100."
        },
        "rabbithole.crt.vignette": {
          "type": "number",
          "default": 35,
          "minimum": 0,
          "maximum": 100,
          "description": "How much the curved glass darkens the edges of the screen, from 0 (none) to 100."
        },
        "rabbithole.crt.effects": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "scanlines",
              "bloom",
              "convergence",
              "roll",
              "flicker"
            ]
          },
          "uniqueItems": true,
          "default": [
            "scanlines",
            "bloom"
          ],
          "description": "Extra CRT effects. Refresh roll and flicker are skipped when the OS asks for reduced motion."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:ext && npm run build:webview",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --sourcemap",
    "build:webview": "esbuild src/webview/main.ts src/webview/mini.ts --bundle --outdir=out/webview --platform=browser --loader:.ttf=base64 --sourcemap && node scripts/copy-assets.js",
    "watch": "node scripts/watch.js",
    "test": "node scripts/test.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "jspdf": "^4.2.1"
  }
}
