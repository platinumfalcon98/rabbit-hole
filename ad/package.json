{
  "name": "rabbit-hole-promo",
  "private": true,
  "version": "1.0.0",
  "description": "The Rabbit Hole promo film, built with Remotion from the real dashboard UI",
  "scripts": {
    "build-ui": "node scripts/build-ui.mjs",
    "prestudio": "node scripts/build-ui.mjs",
    "studio": "remotion studio src/index.ts",
    "prerender": "node scripts/build-ui.mjs",
    "render": "remotion render src/index.ts Promo out/promo-raw.mp4 --codec=h264 --crf=16",
    "prestill": "node scripts/build-ui.mjs",
    "still": "remotion still src/index.ts Promo",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
